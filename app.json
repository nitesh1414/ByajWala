{
  "expo": {
    "name": "ByajWala",
    "slug": "ByajWala",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "byajwala",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.byajwala.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Attach customer photos or ID documents.",
        "NSCameraUsageDescription": "Capture customer photo or ID proof."
      }
    },
    "android": {
      "package": "com.byajwala.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F4C81",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["RECEIVE_BOOT_COMPLETED", "VIBRATE", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0F4C81"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}
